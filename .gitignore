# ── Virtual environment (4.9 GB — torch's CUDA DLLs) ────────────────
# Rebuild with:
#   python -m venv .venv
#   .venv/Scripts/python.exe -m pip install torch torchvision --index-url https://download.pytorch.org/whl/cu124
#   .venv/Scripts/python.exe -m pip install ultralytics fastapi uvicorn python-multipart
.venv/
venv/
__pycache__/
*.py[cod]

# ── Dataset (1.3 GB — re-downloadable from UMN DRUM) ────────────────
# TrashCan 1.0, handle 11299/214865. See README for the fetch + convert steps.
data/

# ── Training artefacts ──────────────────────────────────────────────
# runs/ is regenerated by scripts/train.py. demo_model/best.pt IS committed —
# it is only 6.8 MB and is what makes this repo runnable without retraining.
runs/
*.pt
!demo_model/best.pt

# ── Sample imagery ──────────────────────────────────────────────────
# Frames derived from TrashCan (JAMSTEC-credited). Not redistributed here;
# regenerate locally with scripts/predict.py.
demo_inputs_net/
demo_outputs_net/
demo_net_images.txt

# ── Runtime state ───────────────────────────────────────────────────
backend/reports.json
legacy/reports.json

# ── Secrets (copy the *.env.example files instead) ──────────────────
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# demo account passwords from `npm run seed:demo`
backend/demo-accounts.local.txt
*.local.txt

# ── Node backend ────────────────────────────────────────────────────
node_modules/
npm-debug.log*
# uploaded images, masks and annotated overlays (private user data)
backend/storage/
# local PostgreSQL clusters from `npm run db:local` / the test suite
backend/.pgdata/
backend/.test-pgdata/
coverage/
*.log

# ── OS / editor ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# ── Deployed model ──────────────────────────────────────────────────
# The checkpoint the app serves (inference/service.py default) and the previous ones,
# kept for rollback. Only these files from runs/ are committed; other checkpoints and
# training artefacts stay ignored.
!runs/
runs/**
!runs/**/
!runs/sagarnetra_5k_finetune-3/weights/best.pt
!runs/sagarnetra_gpu_v2/weights/best.pt
!runs/sagarnetra_seaclear_v3/weights/best.pt
