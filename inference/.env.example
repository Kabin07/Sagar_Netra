# SAGAR-NETRA inference service configuration. Copy to inference/.env.
# inference/.env is git-ignored — never commit it.

# Shared secret; must equal INFERENCE_TOKEN in backend/.env (24+ random characters).
SN_INFERENCE_TOKEN=

# Trained checkpoint (relative paths are resolved from the repository root).
SN_MODEL_PATH=runs/sagarnetra_gpu_v2/weights/best.pt

# Keep 127.0.0.1 so only the backend on this machine can reach the service.
SN_INFERENCE_HOST=127.0.0.1
SN_INFERENCE_PORT=8001

# Default confidence threshold (the backend sends its own INFERENCE_CONF per request).
SN_CONF=0.25
# Empty = checkpoint's training size (640). Must be a multiple of 32.
SN_IMGSZ=
# "" = auto (CUDA if available, else CPU), or "cpu", "0", ...
SN_DEVICE=
# Very large photos are downscaled so the long side is at most this many pixels before inference.
SN_MAX_SIDE=1920
