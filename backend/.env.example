# SAGAR-NETRA backend configuration. Copy to backend/.env and fill in real values.
# backend/.env is git-ignored — never commit it.

# ── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
# 127.0.0.1 = this computer only. Use 0.0.0.0 to test from a phone on the same Wi-Fi.
HOST=127.0.0.1
PORT=4000
# Set to 1 when running behind a reverse proxy (nginx, IIS, a tunnel) so rate limits see real client IPs.
TRUST_PROXY=0

# ── PostgreSQL ────────────────────────────────────────────────────────────
# System install:  postgresql://postgres:<password>@localhost:5432/sagar_netra
# npm run db:local prints the URL for the bundled local server (port 5433).
#
# Supabase: use the SESSION POOLER string from Dashboard → Connect (IPv4, port 5432):
#   postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# (the direct db.<ref>.supabase.co host is IPv6-only; port 6543 is the transaction pooler — don't use it)
# URL-encode special characters in the password (@ → %40, # → %23, / → %2F, : → %3A).
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/sagar_netra
# Hosted databases (Supabase): PGSSL=true. Do not put sslmode=... in the URL.
PGSSL=false
# CA certificate to verify the server (Supabase: Project Settings → Database → SSL Configuration → Download)
PGSSL_CA=
# Last resort only: encrypts but does not verify the server certificate.
PGSSL_REJECT_UNAUTHORIZED=true
# Keep at or below the pooler's pool size on hosted plans.
PG_POOL_MAX=10

# ── Auth ──────────────────────────────────────────────────────────────────
# 32+ random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
SESSION_HOURS=8
# true when the site is served over HTTPS (required for real deployments)
COOKIE_SECURE=false
AUTH_RATE_LIMIT=20
API_RATE_LIMIT=1000
REPORT_RATE_LIMIT=60

# ── Frontend ──────────────────────────────────────────────────────────────
# The backend serves frontend/ on the same origin (no CORS needed).
SERVE_FRONTEND=true
FRONTEND_DIR=../frontend
# Comma-separated extra origins allowed to call the API with credentials,
# only needed if a frontend is hosted elsewhere, e.g. http://localhost:5173
CLIENT_ORIGINS=

# ── Image storage ─────────────────────────────────────────────────────────
# Uploaded images, masks and annotated overlays. Kept OUTSIDE the web root and
# only served through authorised /api routes.
STORAGE_DRIVER=local
UPLOAD_DIR=./storage
MAX_UPLOAD_MB=15
MAX_FILES_PER_REPORT=10

# ── Inference service (inference/service.py) ──────────────────────────────
INFERENCE_URL=http://127.0.0.1:8001
# Shared secret; must equal SN_INFERENCE_TOKEN in inference/.env (24+ random chars).
INFERENCE_TOKEN=
INFERENCE_TIMEOUT_MS=120000
INFERENCE_CONF=0.25
# Leave empty to use the checkpoint's training image size (640 for sagarnetra_gpu_v2).
INFERENCE_IMGSZ=
